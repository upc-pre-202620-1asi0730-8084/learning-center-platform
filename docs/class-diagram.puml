@startuml Acme.Center.Platform Class Diagram - Publishing, IAM, Profiles, Shared Bounded Contexts

    title 
        Acme.Center.Platform 
        Class Diagram (v1.1.0)
        Publishing, IAM, Profiles, Shared Bounded Contexts
    end title
    
    package "Shared Bounded Context" as Shared {
        package "Domain.Model" as SharedDomain {
            interface IEntityId<T> {
                +Value: T
            }

            interface IEvent

            interface IAggregateRoot {
                +DomainEvents: IReadOnlyCollection<IEvent>
                +ClearDomainEvents(): void
            }

            abstract class AggregateRoot implements IAggregateRoot {
                -domainEvents: List<IEvent>
                +DomainEvents: IReadOnlyCollection<IEvent>
                #AddDomainEvent(IEvent domainEvent): void
                +ClearDomainEvents(): void
            }

            class Error <<record>> {
                +Code: string
                +Description: string
                +Type: ErrorType
                +{static} None: Error
                +{static} NotFound(string code, string description): Error
                +{static} Conflict(string code, string description): Error
                +{static} Validation(string code, string description): Error
            }

            enum ErrorType {
                Failure
                Validation
                NotFound
                Conflict
                Unauthorized
                Forbidden
            }

            class Result<T> {
                +IsSuccess: bool
                +IsFailure: bool
                +Value: T?
                +Error: Error
                +{static} Success(T value): Result<T>
                +{static} Failure(Error error): Result<T>
                +Match<TResult>(Func<T, TResult> onSuccess, Func<Error, TResult> onFailure): TResult
            }
        }

        package "Domain.Repositories" as SharedRepositories {
            interface IBaseRepository<TEntity> {
                +AddAsync(TEntity entity, CancellationToken cancellationToken): Task
                +FindByIdAsync(int id, CancellationToken cancellationToken): Task<TEntity?>
                +FindByIdAsNoTrackingAsync(int id, CancellationToken cancellationToken): Task<TEntity?>
                +Update(TEntity entity): void
                +Remove(TEntity entity): void
                +ListAsync(CancellationToken cancellationToken): Task<IEnumerable<TEntity>>
                +ListAsNoTrackingAsync(CancellationToken cancellationToken): Task<IEnumerable<TEntity>>
            }

            interface IUnitOfWork {
                +CompleteAsync(CancellationToken cancellationToken): Task
            }
        }

        package "Infrastructure" as SharedInfrastructure {
            class BaseRepository<TEntity> implements IBaseRepository {
                #Context: AppDbContext
                +BaseRepository(AppDbContext context)
            }

            class UnitOfWork implements IUnitOfWork {
                -context: AppDbContext
                +UnitOfWork(AppDbContext context)
                +CompleteAsync(CancellationToken cancellationToken): Task
            }

            class StronglyTypedIdConverter<TId, TValue>

            class DispatchDomainEventsInterceptor {
                -mediator: IMediator
                +DispatchDomainEventsInterceptor(IMediator mediator)
                +SavedChangesAsync(SaveChangesCompletedEventData eventData, int result, CancellationToken ct): ValueTask<int>
            }

            class BearerSecuritySchemeTransformer {
                +TransformAsync(OpenApiDocument document, OpenApiDocumentTransformerContext context, CancellationToken ct): Task
            }

            class GlobalExceptionHandler {
                +TryHandleAsync(HttpContext httpContext, Exception exception, CancellationToken ct): ValueTask<bool>
            }

            package "Mediator.Behaviors" {
                class LoggingCommandBehavior<TCommand, TResult>
                class TransactionCommandBehavior<TCommand, TResult>
                class ExceptionHandlingCommandBehavior<TCommand, TResult>
            }
        }
    }

    package "Publishing Bounded Context" as Publishing {
        package "Domain" as PublishingDomain {
            class TutorialId <<record struct>> implements IEntityId {
                +Value: int
            }

            class CategoryId <<record struct>> implements IEntityId {
                +Value: int
            }

            class AssetId <<record struct>> implements IEntityId {
                +Value: int
            }

            class Tutorial <<Aggregate>> extends AggregateRoot {
                +Tutorial(string title, string summary, CategoryId categoryId)
                +Tutorial(CreateTutorialCommand command)
                +Id: TutorialId
                +Title: string
                +Summary: string
                +CategoryId: CategoryId
                +Category: Category?
                +Assets: IReadOnlyCollection<Asset>
                +Status: EPublishingStatus
                +Readable: bool
                +Viewable: bool
                +HasReadableAssets: bool
                +HasViewableAssets: bool
                +AddVideo(string videoUrl): void
                +Publish(): void
            }
    
            class Category <<Entity>> extends AggregateRoot {
                +Category(string name)
                +Category(CreateCategoryCommand command)
                +Id: CategoryId
                +Name: string
            }
    
            abstract class Asset <<Entity>> {
                +Asset(EAssetType type)
                +Id: AssetId
                +AssetIdentifier: AcmeAssetIdentifier
                +Status: EPublishingStatus
                +Type: EAssetType
                +Readable: bool
                +Viewable: bool
                +SendToEdit(): void
                +SendToApproval(): void
                +ApproveAndLock(): void
                +Reject(): void
                +ReturnToEdit(): void
                +GetContent(): object
            }
    
            class VideoAsset extends Asset {
                +VideoAsset(string videoUrl)
                +VideoUri: Uri?
                +Readable: bool = false
                +Viewable: bool = true
            }
    
            class ImageAsset extends Asset {
                +ImageAsset()
                +ImageUri: Uri?
                +Readable: bool = false
                +Viewable: bool = true
            }
    
            class ReadableContentAsset extends Asset {
                +ReadableContentAsset()
                +Readable: bool = true
                +Viewable: bool = false
            }
    
            enum EPublishingStatus <<ValueObject>> {
                Draft
                ReadyToEdit
                ReadyToApproval
                ApprovedAndLocked
            }

            class TutorialCreatedEvent <<record>> implements IEvent {
                +TutorialId: TutorialId
                +Title: string
                +CategoryId: CategoryId
            }

            class TutorialPublishedEvent <<record>> implements IEvent {
                +TutorialId: TutorialId
            }

            class CategoryCreatedEvent <<record>> implements IEvent {
                +CategoryId: CategoryId
                +Name: string
            }
    
            interface ITutorialQueryService {
                +Handle(GetTutorialByIdQuery query, CancellationToken cancellationToken): Task<Tutorial?>
                +Handle(GetAllTutorialsQuery query, CancellationToken cancellationToken): Task<IEnumerable<Tutorial>>
                +Handle(GetAllTutorialsByCategoryIdQuery query, CancellationToken cancellationToken): Task<IEnumerable<Tutorial>>
            }
    
            interface ITutorialCommandService {
                +Handle(AddVideoAssetToTutorialCommand command, CancellationToken cancellationToken): Task<Result<Tutorial>>
                +Handle(CreateTutorialCommand command, CancellationToken cancellationToken): Task<Result<Tutorial>>
            }
    
            interface ICategoryQueryService {
                +Handle(GetCategoryByIdQuery query, CancellationToken cancellationToken): Task<Category?>
                +Handle(GetAllCategoriesQuery query, CancellationToken cancellationToken): Task<IEnumerable<Category>>
            }
    
            interface ICategoryCommandService {
                +Handle(CreateCategoryCommand command, CancellationToken cancellationToken): Task<Result<Category>>
            }
    
            interface ITutorialRepository extends IBaseRepository {
                +FindByIdAsync(TutorialId id, CancellationToken cancellationToken): Task<Tutorial?>
                +FindByIdAsNoTrackingAsync(TutorialId id, CancellationToken cancellationToken): Task<Tutorial?>
                +FindByCategoryIdAsync(CategoryId categoryId, CancellationToken cancellationToken): Task<IEnumerable<Tutorial>>
                +FindByCategoryIdAsNoTrackingAsync(CategoryId categoryId, CancellationToken cancellationToken): Task<IEnumerable<Tutorial>>
                +ExistsByTitleAsync(string title, CancellationToken cancellationToken): Task<bool>
            }
    
            interface ICategoryRepository extends IBaseRepository {
                +FindByIdAsync(CategoryId id, CancellationToken cancellationToken): Task<Category?>
                +FindByIdAsNoTrackingAsync(CategoryId id, CancellationToken cancellationToken): Task<Category?>
                +ExistsByNameAsync(string name, CancellationToken cancellationToken): Task<bool>
            }
        }
    
        package "Application" as PublishingApplication {
            class TutorialCommandService implements ITutorialCommandService {
                +TutorialCommandService(ITutorialRepository tutorialRepository, ICategoryRepository categoryRepository, IUnitOfWork unitOfWork, IStringLocalizer<ErrorMessages> localizer)
                +Handle(AddVideoAssetToTutorialCommand command, CancellationToken cancellationToken): Task<Result<Tutorial>>
                +Handle(CreateTutorialCommand command, CancellationToken cancellationToken): Task<Result<Tutorial>>
            }
    
            class TutorialQueryService implements ITutorialQueryService {
                +TutorialQueryService(ITutorialRepository tutorialRepository)
                +Handle(GetTutorialByIdQuery query, CancellationToken cancellationToken): Task<Tutorial?>
                +Handle(GetAllTutorialsQuery query, CancellationToken cancellationToken): Task<IEnumerable<Tutorial>>
                +Handle(GetAllTutorialsByCategoryIdQuery query, CancellationToken cancellationToken): Task<IEnumerable<Tutorial>>
            }
    
            class CategoryCommandService implements ICategoryCommandService {
                +CategoryCommandService(ICategoryRepository categoryRepository, IUnitOfWork unitOfWork, IMediator domainEventPublisher, IStringLocalizer<ErrorMessages> localizer)
                +Handle(CreateCategoryCommand command, CancellationToken cancellationToken): Task<Result<Category>>
            }
    
            class CategoryQueryService implements ICategoryQueryService {
                +CategoryQueryService(ICategoryRepository categoryRepository)
                +Handle(GetCategoryByIdQuery query, CancellationToken cancellationToken): Task<Category?>
                +Handle(GetAllCategoriesQuery query, CancellationToken cancellationToken): Task<IEnumerable<Category>>
            }

            class CategoryCreatedEventHandler {
                +Handle(CategoryCreatedEvent domainEvent, CancellationToken cancellationToken): Task
            }

            class TutorialCreatedEventHandler {
                +Handle(TutorialCreatedEvent domainEvent, CancellationToken cancellationToken): Task
            }
        }
    
        package "Infrastructure" as PublishingInfrastructure {
            class TutorialRepository extends BaseRepository implements ITutorialRepository
            class CategoryRepository extends BaseRepository implements ICategoryRepository
        }
    
        package "Interfaces.Rest" as PublishingRest {
            class TutorialsController {
                +GetTutorialById(int id, CancellationToken cancellationToken): Task<IActionResult>
                +CreateTutorial(CreateTutorialResource resource, CancellationToken cancellationToken): Task<IActionResult>
                +GetAllTutorials(CancellationToken cancellationToken): Task<IActionResult>
                +AddVideoToTutorial(AddVideoAssetToTutorialResource resource, int id, CancellationToken cancellationToken): Task<IActionResult>
            }
    
            class CategoriesController {
                +GetCategoryById(int id, CancellationToken cancellationToken): Task<IActionResult>
                +CreateCategory(CreateCategoryResource resource, CancellationToken cancellationToken): Task<IActionResult>
                +GetAllCategories(CancellationToken cancellationToken): Task<IActionResult>
            }
    
            class CategoryTutorialsController {
                +GetTutorialsByCategoryId(int categoryId, CancellationToken cancellationToken): Task<IActionResult>
            }
        }
    
        Tutorial --> Category : belongs to
        Tutorial *-- Asset : contains
        Asset <|-- VideoAsset
        Asset <|-- ImageAsset
        Asset <|-- ReadableContentAsset
        TutorialCommandService ..> ITutorialRepository
        TutorialQueryService ..> ITutorialRepository
        CategoryCommandService ..> ICategoryRepository
