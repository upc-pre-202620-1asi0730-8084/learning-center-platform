        TutorialsController ..> ITutorialQueryService
        CategoriesController ..> ICategoryCommandService
        CategoriesController ..> ICategoryQueryService
        CategoryTutorialsController ..> ITutorialQueryService
    }
    
    package "IAM Bounded Context" as Iam {
        package "Domain" as IamDomain {
            class UserId <<record struct>> implements IEntityId {
                +Value: int
            }

            class User <<Aggregate>> extends AggregateRoot {
                +User(string username, string passwordHash)
                +Id: UserId
                +Username: string
                +PasswordHash: string
                +UpdateUsername(string username): User
                +UpdatePasswordHash(string passwordHash): User
            }

            class UserRegisteredEvent <<record>> implements IEvent {
                +UserId: UserId
                +Username: string
            }
    
            interface IUserCommandService {
                +Handle(SignInCommand command, CancellationToken cancellationToken): Task<Result<(User user, string token)>>
                +Handle(SignUpCommand command, CancellationToken cancellationToken): Task<Result<User>>
